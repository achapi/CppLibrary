void multiple_zeta(vector<mint> &a){
	int n = a.size() - 1;
	for (int p = 2; p <= n; p++){
		if (a.size() <= (size_t)p) break;
	}
	for (int i = 1; i <= n; i++){
		for (int j = i * 2; j <= n; j += i){
			a[i] += a[j];
		}
	}
}
void multiple_mobius(vector<mint> &a){
	int n = a.size() - 1;
	for (int i = n; i >= 1; i--){
		for (int j = i * 2; j <= n; j += i){
			a[i] -= a[j];
		}
	}
}
vector<mint> gcd_convolution(vector<mint> a, vector<mint> b){
	int n = a.size() - 1;
	multiple_zeta(a);
	multiple_zeta(b);
	for (int i = 1; i <= n; i++) a[i] *= b[i];
	multiple_mobius(a);
	return a;
}
