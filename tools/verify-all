#!/usr/bin/env bash
set -euo pipefail
root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root_dir"
for source_file in verify/*.test.cpp; do
  problem=$(sed -n 's|.*judge\.yosupo\.jp/problem/\([^" ]*\).*|\1|p' "$source_file" | head -1)
  if [[ -z "$problem" ]]; then
    echo "PROBLEM is missing: $source_file" >&2
    exit 2
  fi
  echo "===== $problem ====="
  tools/yosupo-test "$problem" "$source_file"
done
