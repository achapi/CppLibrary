#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: tools/yosupo-test <problem> <source.cpp> [time-limit-seconds]

Example:
  tools/yosupo-test unionfind test/unionfind.cpp
  tools/yosupo-test convolution_mod test/convolution_mod.cpp 10
EOF
}

if [[ $# -lt 2 || $# -gt 3 ]]; then
  usage >&2
  exit 2
fi

problem=$1
source_file=$2
time_limit=${3:-5}

if [[ ! -f "$source_file" ]]; then
  echo "source file not found: $source_file" >&2
  exit 2
fi
if [[ ! "$time_limit" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "time limit must be a positive number: $time_limit" >&2
  exit 2
fi

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
work_dir="$root_dir/.yosupo"
problems_dir="$work_dir/library-checker-problems"
venv_dir="$work_dir/venv"
build_dir="$work_dir/build/$problem"

mkdir -p "$work_dir" "$build_dir"

if [[ ! -d "$problems_dir/.git" ]]; then
  echo "==> cloning library-checker-problems"
  git clone --depth 1 https://github.com/yosupo06/library-checker-problems.git "$problems_dir"
fi

if [[ ! -x "$venv_dir/bin/python" ]]; then
  echo "==> creating Python environment"
  python3 -m venv "$venv_dir"
  "$venv_dir/bin/pip" install --disable-pip-version-check -r "$problems_dir/requirements.txt"
fi

echo "==> generating test cases: $problem"
(
  cd "$problems_dir"
  ulimit -s unlimited
  "$venv_dir/bin/python" generate.py -p "$problem"
)

info_file=$(find "$problems_dir" -path "*/$problem/info.toml" -print -quit)
if [[ -z "$info_file" ]]; then
  echo "unknown problem: $problem" >&2
  exit 2
fi
problem_dir=${info_file%/info.toml}

echo "==> compiling: $source_file"
g++ -std=gnu++20 -O2 -pipe -Wall -Wextra "$source_file" -o "$build_dir/main"

checker="$problem_dir/checker"
if [[ ! -x "$checker" ]]; then
  echo "checker was not generated: $checker" >&2
  exit 1
fi

passed=0
for input_file in "$problem_dir"/in/*; do
  case_name=$(basename "$input_file")
  answer_file="$problem_dir/out/${case_name%.in}.out"
  output_file="$build_dir/$case_name.out"
  checker_log="$build_dir/$case_name.checker.log"

  set +e
  timeout --signal=KILL "$time_limit" "$build_dir/main" < "$input_file" > "$output_file"
  status=$?
  set -e
  if ((status != 0)); then
    echo "[FAIL] $case_name (runtime error or timeout, status=$status)" >&2
    exit 1
  fi
  if ! "$checker" "$input_file" "$output_file" "$answer_file" >"$checker_log" 2>&1; then
    echo "[FAIL] $case_name (wrong answer)" >&2
    sed -n '1,20p' "$checker_log" >&2
    echo "output: $output_file" >&2
    exit 1
  fi
  rm -f "$checker_log"
  passed=$((passed + 1))
  echo "[PASS] $case_name"
done

echo "==> AC ($passed cases)"
